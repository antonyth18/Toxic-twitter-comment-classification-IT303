# Server Configuration
PORT=5000

# Database URL (used by Prisma)
# Replace 'db' with 'localhost' if running Node outside of Docker but using Docker for Postgres
DATABASE_URL=postgresql://postgres:password@db:5432/toxic_comments?schema=public

# Authentication Security
JWT_SECRET=your_jwt_secret_key_here

# Internal Microservices
CLASSIFIER_SERVICE_URL=http://classifier-service:8000

# Twitter / X API Keys (For Phase 2)
TWITTER_API_KEY=placeholder_api_key
TWITTER_API_SECRET=placeholder_api_secret
TWITTER_BEARER_TOKEN=placeholder_bearer_token
